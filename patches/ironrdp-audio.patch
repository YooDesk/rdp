diff --git a/crates/ironrdp-web/src/yoodesk_audio.rs b/crates/ironrdp-web/src/yoodesk_audio.rs
new file mode 100644
index 0000000..eee6e36
--- /dev/null
+++ b/crates/ironrdp-web/src/yoodesk_audio.rs
@@ -0,0 +1,159 @@
+//! YooDesk browser audio adapter, MIT. RDPSND protocol remains in upstream IronRDP.
+//! JS callbacks stay thread-local; the Send backend contains only an ID and PCM formats.
+use ironrdp::dvc::{DvcClientProcessor, DvcEncode, DvcMessage, DvcProcessor};
+use ironrdp::pdu::{PduResult, encode_err};
+use ironrdp::rdpsnd::client::Rdpsnd;
+use ironrdp::rdpsnd::client::RdpsndClientHandler;
+use ironrdp::rdpsnd::pdu::{AudioFormat, PitchPdu, VolumePdu, WaveFormat};
+use ironrdp::svc::SvcProcessor;
+use ironrdp_core::{Encode, EncodeResult, WriteCursor, impl_as_any};
+use std::borrow::Cow;
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use wasm_bindgen::JsValue;
+
+thread_local! {
+    static CALLBACKS: RefCell<BTreeMap<u64, js_sys::Function>> = const { RefCell::new(BTreeMap::new()) };
+    static NEXT: Cell<u64> = const { Cell::new(0) };
+}
+
+#[derive(Debug)]
+pub(crate) struct BrowserAudio {
+    id: u64,
+    formats: Vec<AudioFormat>,
+    negotiated: Vec<AudioFormat>,
+}
+
+impl BrowserAudio {
+    pub(crate) fn new(callback: js_sys::Function) -> Self {
+        let id = NEXT.with(|next| {
+            let id = next.get() + 1;
+            next.set(id);
+            id
+        });
+        CALLBACKS.with(|callbacks| callbacks.borrow_mut().insert(id, callback));
+        let mut formats = Vec::new();
+        for rate in [48000, 44100, 22050] {
+            for channels in [2, 1] {
+                formats.push(AudioFormat {
+                    format: WaveFormat::PCM,
+                    n_channels: channels,
+                    n_samples_per_sec: rate,
+                    n_avg_bytes_per_sec: rate * u32::from(channels) * 2,
+                    n_block_align: channels * 2,
+                    bits_per_sample: 16,
+                    data: None,
+                });
+            }
+        }
+        let backend = Self {
+            id,
+            formats,
+            negotiated: Vec::new(),
+        };
+        backend.notify("channel", &JsValue::TRUE, 0, 0);
+        backend
+    }
+
+    fn notify(&self, kind: &str, data: &JsValue, channels: u16, rate: u32) {
+        let callback = CALLBACKS.with(|callbacks| callbacks.borrow().get(&self.id).cloned());
+        if let Some(callback) = callback {
+            if callback
+                .call4(
+                    &JsValue::NULL,
+                    &JsValue::from_str(kind),
+                    data,
+                    &JsValue::from(channels),
+                    &JsValue::from(rate),
+                )
+                .is_err()
+            {
+                tracing::error!("Browser audio callback failed");
+            }
+        }
+    }
+}
+
+impl RdpsndClientHandler for BrowserAudio {
+    fn get_formats(&self) -> &[AudioFormat] {
+        &self.formats
+    }
+    fn negotiated_formats(&mut self, formats: &[AudioFormat]) {
+        self.negotiated = formats.to_vec();
+        self.notify("formats", &JsValue::from(formats.len() as u32), 0, 0);
+    }
+    fn wave(&mut self, index: usize, _timestamp: u32, data: Cow<'_, [u8]>) {
+        let Some(format) = self.negotiated.get(index) else {
+            self.notify(
+                "error",
+                &JsValue::from_str("Invalid negotiated audio format index"),
+                0,
+                0,
+            );
+            return;
+        };
+        if data.len() > 2 * 1024 * 1024 || data.len() % usize::from(format.n_block_align) != 0 {
+            self.notify("error", &JsValue::from_str("Invalid PCM audio block"), 0, 0);
+            return;
+        }
+        self.notify(
+            "pcm",
+            &js_sys::Uint8Array::from(data.as_ref()).into(),
+            format.n_channels,
+            format.n_samples_per_sec,
+        );
+    }
+    fn set_volume(&mut self, _volume: VolumePdu) {}
+    fn set_pitch(&mut self, _pitch: PitchPdu) {}
+    fn close(&mut self) {
+        self.notify("close", &JsValue::NULL, 0, 0);
+    }
+}
+
+impl Drop for BrowserAudio {
+    fn drop(&mut self) {
+        CALLBACKS.with(|callbacks| callbacks.borrow_mut().remove(&self.id));
+    }
+}
+
+/// MS-RDPEA: modern Windows opens AUDIO_PLAYBACK_DVC instead of sending on rdpsnd SVC.
+pub(crate) struct BrowserAudioDvc(Rdpsnd);
+impl BrowserAudioDvc {
+    pub(crate) fn new(callback: js_sys::Function) -> Self {
+        Self(Rdpsnd::new(Box::new(BrowserAudio::new(callback))))
+    }
+}
+impl_as_any!(BrowserAudioDvc);
+impl DvcClientProcessor for BrowserAudioDvc {}
+impl DvcProcessor for BrowserAudioDvc {
+    fn channel_name(&self) -> &str {
+        "AUDIO_PLAYBACK_DVC"
+    }
+    fn start(&mut self, _id: u32) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+    fn process(&mut self, _id: u32, payload: &[u8]) -> PduResult<Vec<DvcMessage>> {
+        self.0
+            .process(payload)?
+            .into_iter()
+            .map(|message| {
+                Ok(Box::new(AudioReply(
+                    message.encode_unframed_pdu().map_err(|e| encode_err!(e))?,
+                )) as DvcMessage)
+            })
+            .collect()
+    }
+}
+struct AudioReply(Vec<u8>);
+impl DvcEncode for AudioReply {}
+impl Encode for AudioReply {
+    fn encode(&self, dst: &mut WriteCursor<'_>) -> EncodeResult<()> {
+        self.0.encode(dst)
+    }
+    fn name(&self) -> &'static str {
+        "RDPSND audio reply"
+    }
+    fn size(&self) -> usize {
+        self.0.len()
+    }
+}
